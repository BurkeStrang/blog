<Project Sdk="Aspire.AppHost.Sdk/13.3.5">

  <ItemGroup>
    <ProjectReference Include="..\..\api-dotnet\BlogApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive via Aspire.Hosting 13.3.5, which pulls MessagePack 2.5.192 —
         flagged by eleven advisories, including GHSA-hv8m-jj95-wg3x (high).
         All of them are fixed in 2.5.301, so this pins forward to the last 2.x
         release rather than crossing to 3.x, which Aspire doesn't reference.
         Drop this once Aspire ships with a patched version. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>57334b44-dd33-45c8-bb67-30b1bbc67bde</UserSecretsId>
  </PropertyGroup>

</Project>
