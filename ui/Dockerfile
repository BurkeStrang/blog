# syntax=docker/dockerfile:1.7
# Build stage
FROM node:26-alpine AS builder

WORKDIR /app

# Install pnpm (must match package.json#packageManager)
# node:26-alpine doesn't ship corepack, so install pnpm globally instead.
RUN npm install -g pnpm@11.1.1

# Copy package files first so dependency layer can be cached when only source changes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dependencies with a BuildKit cache mount for the pnpm store
RUN --mount=type=cache,id=pnpm,target=/pnpm-store \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Accept build argument for API URL
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Full build (type-check + lint + audit + vite production build)
RUN pnpm build

# Production stage: nginx-brotli (nginx with ngx_brotli module compiled in)
# fholzer/nginx-brotli is alpine-based and serves the pre-compressed .br files
# generated by vite's compressionPlugin.
FROM fholzer/nginx-brotli:v1.28.0

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user and set permissions
RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser && \
    chown -R appuser:appuser /usr/share/nginx/html /var/cache/nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appuser /var/run/nginx.pid

# Switch to non-root user
USER appuser

# Expose non-privileged port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Start nginx. fholzer/nginx-brotli already sets ENTRYPOINT=["nginx"], so pass
# only the args here — keeping both layers explicit avoids "nginx nginx -g ..."
# if the base image's entrypoint ever changes.
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
